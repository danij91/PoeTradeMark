{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.1",
  "description": "__MSG_extDesc__",
  "default_locale": "ko",
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["*://*.pathofexile.com/*", "*://poe.kakaogames.com/*", "https://poe.ninja/*"],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pathofexile.com/trade/*", "*://*.pathofexile.com/trade2/*", "*://poe.kakaogames.com/trade/*", "*://poe.kakaogames.com/trade2/*"],
      "js": ["src/common/i18n.js", "src/common/url.js", "src/common/storage.js", "src/common/rates.js", "src/assets/currency-meta.js", "src/assets/currency-meta-poe1.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/currency/*.png", "src/assets/currency/poe1/*.png"],
      "matches": ["*://*.pathofexile.com/*", "*://poe.kakaogames.com/*"]
    }
  ]
}
