{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDesc__",
  "default_locale": "ko",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["*://*.pathofexile.com/*", "*://poe.kakaogames.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pathofexile.com/trade/*", "*://poe.kakaogames.com/trade/*"],
      "js": ["src/common/url.js", "src/common/storage.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.pathofexile.com/trade/*", "*://poe.kakaogames.com/trade/*"],
      "js": ["src/content/live.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
